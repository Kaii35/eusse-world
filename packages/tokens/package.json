{
  "name": "@eusse/tokens",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./landing-theme.css": "./src/landing-theme.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@eusse/config-eslint": "workspace:*",
    "@eusse/config-typescript": "workspace:*",
    "eslint": "^9.18.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
