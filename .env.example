# =============================================================================
# Eusse World — variables de entorno
# =============================================================================
# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env. NUNCA pongas un secreto tras el prefijo NEXT_PUBLIC_.
#
# Todas las variables se validan con Zod al arrancar. Si falta una obligatoria,
# el proceso NO arranca. Es deliberado: mejor fallar al arrancar que en producción.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development                      # development | test | production
APP_ENV=local                             # local | preview | staging | production
TENANT_ID=eusse                           # multi-marca: un solo tenant en Fase 1

# --- apps/api ----------------------------------------------------------------
API_PORT=3001
API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002   # sin comodines

# --- PostgreSQL --------------------------------------------------------------
# Si ya tienes un PostgreSQL en el 5432, cambia POSTGRES_PORT y el puerto de DATABASE_URL.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://eusse:eusse@localhost:5432/eusse
DATABASE_POOL_MAX=10
# Producción: usar PgBouncer en modo transacción
# DATABASE_DIRECT_URL=                    # conexión directa, sólo para migraciones

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=eusse

# --- Autenticación (SECRETOS) ------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=                        # SECRETO
JWT_REFRESH_SECRET=                       # SECRETO
INTENT_SIGNING_SECRET=                    # SECRETO — firma la intención de compra (RFC-0004)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
INTENT_TTL=30m                            # ver RFC-0004
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                       # true en cualquier entorno que no sea local

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_SEARCH_PER_MIN=60

# --- Almacenamiento de objetos (S3 / MinIO) ----------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=eusse-media
STORAGE_ACCESS_KEY=                       # SECRETO
STORAGE_SECRET_KEY=                       # SECRETO
STORAGE_PUBLIC_URL=http://localhost:9000/eusse-media
SIGNED_URL_TTL=900                        # segundos

# --- Email -------------------------------------------------------------------
MAIL_TRANSPORT=smtp                       # smtp | console
MAIL_HOST=localhost
MAIL_PORT=1025                            # MailHog en local
MAIL_USER=
MAIL_PASSWORD=                            # SECRETO
MAIL_FROM="Eusse World <no-reply@eusse.world>"

# --- Colas -------------------------------------------------------------------
QUEUE_CONCURRENCY=5
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
JOB_MAX_ATTEMPTS=5

# --- Observabilidad ----------------------------------------------------------
LOG_LEVEL=debug                           # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=eusse-api

# --- Pagos (Fase 2) ----------------------------------------------------------
PAYMENT_PROVIDER=offline                  # offline | <proveedor> — ver ADR-0018
# PAYMENT_API_KEY=                        # SECRETO
# PAYMENT_WEBHOOK_SECRET=                 # SECRETO

# =============================================================================
# apps/web — PÚBLICO
# =============================================================================
# Todo lo que lleve NEXT_PUBLIC_ llega al navegador.
# Un secreto aquí es un incidente de seguridad, no un descuido.
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_SUPPORTED_LOCALES=es,en
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/eusse-media

# --- apps/admin --------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
