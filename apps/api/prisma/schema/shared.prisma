/// Outbox transaccional (ADR-0014).
///
/// El evento se escribe en la MISMA transacción que el cambio de estado. Un relay lo
/// publica después. Elimina por diseño la clase entera de bugs "se guardó pero no se
/// notificó".
model OutboxEvent {
  id            String    @id @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  /// Clave de deduplicación en el consumidor. UUID v7.
  eventId       String    @unique @map("event_id") @db.Uuid
  /// `<contexto>.<Agregado><VerboPasado>.v<N>` — p. ej. orders.OrderPlaced.v1
  type          String    @db.VarChar(128)
  /// Payload autocontenido: el consumidor no debe consultar al emisor.
  payload       Json
  tenantId      String    @map("tenant_id") @db.VarChar(64)
  correlationId String    @map("correlation_id") @db.VarChar(128)
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz
  status        String    @default("PENDING") @db.VarChar(16)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// sirve: el relay busca pendientes por antigüedad (FOR UPDATE SKIP LOCKED)
  @@index([status, occurredAt])
  @@map("outbox_events")
  @@schema("shared")
}

/// Deduplicación de consumidores.
///
/// La entrega es at-least-once: el mensaje LLEGARÁ dos veces. Un handler que no tolera
/// reprocesamiento es un bug, no una limitación de la infraestructura.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([eventId, handler])
  @@map("processed_events")
  @@schema("shared")
}

/// Idempotencia de mutaciones (RFC-0012 §4.5).
///
/// Misma clave + mismo payload -> misma respuesta, sin efectos.
/// Misma clave + payload distinto -> 409 COMMON_IDEMPOTENCY_CONFLICT.
model IdempotencyRecord {
  id             String   @id @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  /// Hash del payload, para detectar la misma clave con datos distintos.
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  /// La restricción que impide órdenes duplicadas por doble clic (riesgo R-04)
  @@unique([accountId, idempotencyKey])
  /// sirve: job de limpieza de registros caducados
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("shared")
}
